# These are ADDED AUTOMATICALLY when you connect the Supabase integration in Vercel.
# Only copy them here (as .env) if you want to run the project on your own computer.
SUPABASE_URL=https://xrfehvxqchskxcjytkvv.supabase.co
SUPABASE_ANON_KEY=paste-your-anon-or-publishable-key-here
# Postgres connection string (Supabase > Connect > Transaction pooler). Server-side only. Never expose it.
POSTGRES_URL=postgres://postgres.xrfehvxqchskxcjytkvv:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
